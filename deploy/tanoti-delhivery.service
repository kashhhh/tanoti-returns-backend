[Unit]
Description=Refresh Tanoti Delhivery shipment tracking
After=network-online.target

[Service]
Type=oneshot
# Match the user and environment settings of the existing tanoti service.
User=tanoti
Group=tanoti
WorkingDirectory=/var/www/tanoti-returns/backend
EnvironmentFile=-/etc/tanoti/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/tanoti-returns/backend/.venv/bin/flask --app run.py sync-delhivery
TimeoutStartSec=3600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
