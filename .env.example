SECRET_KEY=
ADMIN_SECRET_KEY=
APP_ENV=production
# Only behind the nginx configuration in deploy/, with Gunicorn bound to loopback.
TRUST_PROXY=true
CORS_ORIGINS=https://returns.tanotiofficial.com
# Existing ADMIN_API_KEY is accepted as a fallback secret, but never grants API access alone.
TESTING_MODE=false
DATABASE_URL=postgresql://user:password@localhost:5432/tanoti_returns

# Shopify (custom app, static Admin API token)
SHOPIFY_STORE_DOMAIN=tanoti-official.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-10

# Resend
RESEND_API_KEY=
EMAIL_FROM=returns@tanotiofficial.com

PHOTO_RETENTION_DAYS=120

# Delhivery
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_LOCATION=
# Explicitly use production on the VPS; staging is for development testing only.
DELHIVERY_ENVIRONMENT=production
# Set if required for your Delhivery account; use your actual tax details.
DELHIVERY_SELLER_GST=
DELHIVERY_HSN_CODE=

# Local compressed photo storage
MAX_PHOTO_STORAGE_MB=500
# PHOTOS_STORAGE_DIR=/absolute/path/to/uploads

# Must match the Shopify store currency for gift-card verification.
SHOP_CURRENCY=INR
# Optional customer OTP delivery through Meta WhatsApp Cloud API.
# Use an approved AUTHENTICATION template with a copy-code button.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=tanoti_returns_login
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
