APP_ENV=development
# Generate a random secret of at least 32 characters before starting.
SECRET_KEY=
ADMIN_API_KEY=dev-admin-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tanoti_returns


# Local testing switches -- leave these on until you're ready to connect
# real Shopify/Resend/DO Spaces accounts:
TESTING_MODE=true
# TESTING_MODE logs OTPs locally; Shopify operations still use the real store.

SHOPIFY_STORE_DOMAIN=tanoti-official.myshopify.com
SHOPIFY_API_VERSION=2026-10
